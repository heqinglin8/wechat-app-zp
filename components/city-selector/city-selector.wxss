.city-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  /* min-width: 148rpx; */
  height: 72rpx;
  padding: 0 10rpx 0 20rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 28rpx;
  white-space: nowrap;
}

.city-selector-name {
  display: block;
  max-width: 4.5em;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 600;
}

.city-selector-arrow {
  margin-left: 6rpx;
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
  color: #fff;
}
