.fab-container {
  position: fixed;
  right: 30rpx;
  bottom: 60rpx;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}
.fab-btn {
  width: 100rpx;
  height: 100rpx;
  background: #fc3;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 900;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.18);
  margin-bottom: 20rpx;
  cursor: pointer;
}
.fab-btn-second {
  margin-bottom: 0;
  background: #ffe066;
  color: #fff;
}
