
/**index.wxss**/
@import "../../wxSearchView/wxSearchView.wxss";
.container{
  padding:0;
  margin: 0;
}
.weui-search-bar,.weui-search-bar__form,.weui-search-bar__box,.weui-search-bar__input{
  width:100%;
}
.index-topbar{
  display:flex;
  align-items:center;
  width:100%;
  background:#fc3;
}
.index-topbar .weui-search-bar{
  flex:1;
  width:auto;
}
.weui-search-bar{
  border: 0rpx;
  margin-top: 0rpx;
}
/*******导航*****/
/********要改的开始*********/
.nav{
  background-color: #fff;
  margin-top: 7px;
  box-shadow: 0px 0px 3px rgba(55,55,55,0.5);
  width:100%;
  height:400rpx;
  padding: 0px;
}
.nav-up{
  margin: 0px;
  padding: 0px;
  width:100%;
  height:190rpx;
}
.nav-down{
  margin: 0px;
  padding: 0px;
  width:100%;
  height:190rpx;
}
.nav-all{
  overflow: hidden;
  float:left;
  height:100%;
  width:25%;
}

.nav-all-img{
  width:100%;
  height:180rpx;
}
.nav-all-img image{
  width: 110rpx;
  height:110rpx;
  border-radius: 55rpx;
  margin-top: 25rpx;
  margin-left: 42rpx;
}
.nav-one-up-img image{
  background-color: #f96;
}
.nav-tow-up-img image{
  background-color: #39f;
}
.nav-three-up-img image{
  background-color: #9f3;
}
.nav-four-up-img image{
  background-color: #f69;
}
.nav-one-down-img image{
  background-color: #6c3;
}
.nav-tow-down-img image{
  background-color: #96f;
}
.nav-three-down-img image{
  background-color: #fc3;
}
.nav-four-down-img image{
  background-color: #6cf;
}
.nav-text{
  color: #000;
  font-size: 13px;
   padding: 0px;
  margin-top:-30rpx;
  text-align: center;
  width:100%;
  height:40rpx;
}
/********招聘公司列表*********/
.scoll-h{
  height: 100%;
  margin: 0;
  background: #f5f5f5;
  box-sizing: border-box;
  padding: 16rpx 16rpx 24rpx;
}
.job-card{
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx 26rpx;
  border-radius: 14rpx;
  background: #fff;
  box-sizing: border-box;
}
.job-card__header{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.job-card__title-wrap{
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}
.job-card__title{
  max-width: 100%;
  color: #111;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 700;
}
.job-card__salary{
  flex: none;
  color: #13aaa3;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  white-space: nowrap;
}
.job-card__badge{
  height: 32rpx;
  line-height: 30rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 2rpx solid #9b9b9b;
  border-radius: 8rpx;
  color: #777;
  font-size: 22rpx;
  box-sizing: border-box;
}
.job-card__badge--primary{
  border-color: #b8794e;
  color: #b8794e;
}
.job-card__company{
  display: flex;
  flex-wrap: wrap;
  gap: 0 28rpx;
  margin-top: 18rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 40rpx;
}
.job-card__company text{
  margin-right: 28rpx;
}
.job-card__tags{
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}
.job-card__tag{
  max-width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f4f4f4;
  color: #666;
  font-size: 26rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}
.job-card__footer{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
}
.job-card__recruiter{
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}
.job-card__avatar{
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e9e9e9;
}
.job-card__avatar--empty{
  position: relative;
}
.job-card__avatar--empty::after{
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #bdbdbd;
}
.job-card__recruiter-name{
  margin-left: 14rpx;
  color: #333;
  font-size: 27rpx;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.job-card__location{
  flex: none;
  max-width: 260rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: right;
}
/*轮播图*/
swiper {
    height: 500rpx;
}
swiper-item image {
    width: 100%;
    height: 100%;
}
.swiper-container{
  position: relative;
}
.swiper-container .swiper{
  height: 380rpx;
}
.swiper-container .swiper .img{
  width: 100%;
  height: 100%;
}
.loading{
  width: 100%;
  height: 30px;
  text-align: center;
  line-height: 30px;
  color: #888;
  font-size: 15px;
  border-top: 1px #F7F7F7 solid;
  border-bottom: 1px #F7F7F7 solid;
}
.empty-state{
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 30rpx;
}
.empty-state__text{
  margin-bottom: 24rpx;
}
.empty-state__button{
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  border-radius: 6rpx;
  background: #fc3;
  color: #000;
  font-size: 28rpx;
}
.empty-state__button::after{
  border: none;
}
/*滚动tab*/
.tab-h{
    height: 80rpx;width: 100%; box-sizing: border-box;margin-left: auto;margin-right: auto;margin-top: 0;
    line-height: 80rpx;background: #fff; font-size: 16px; white-space: nowrap;top:0; left: 0; z-index: 99;}
.tab-item{margin:0;display: inline-block;width: 25%;text-align: center;}
.tab-item.active{position: relative;background: #fc3;}
.tab-content{margin-top: 3rpx;height:1000rpx;}

.conbtn{
background-color:#fff;
} 
button::after{
border: none;
}
