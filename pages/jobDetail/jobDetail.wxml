<!--pages/index/detail.wxml-->
<view class="detail">
  <view class="det-image">
    <swiper 
      class="swiper-container"
      indicator-dots="{{true}}"
      autoplay="true"
      interval="5000"
      duration="500"
      bindchange="onPhotoSwiperChange">
      <swiper-item wx:for="{{photoList}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill"/>
      </swiper-item>
    </swiper>
    <!-- 圆形指示器
    <view class="swiper-dots">
      <view 
        wx:for="{{photoList}}" 
        wx:key="index"
        class="dot {{currentPhotoIndex === index ? 'active' : ''}}">
      </view>
    </view>
     -->
  </view>
  <view class="det-main">
    <view class="det-list">
      <view class='det-list-one'>{{viewData.title}}</view>
      <view class='det-list-tow'>
        <view class='det-list-tow-one'>{{viewData.topPayText}}</view>
        <view class="det-list-actions">
          <button class="det-list-action" open-type="share">
            <text class="det-list-action-icon">↗</text>
            <text class="det-list-action-text">分享</text>
          </button>
          <button class="det-list-action" bindtap="bindCollectJob">
            <text class="det-list-action-icon">{{hasCollected ? '★' : '☆'}}</text>
            <text class="det-list-action-text">收藏</text>
          </button>
        </view>
      </view>
      <view class='det-list-meta'>
        <view class='det-list-meta-item'>
          <text class="det-list-meta-icon">📍</text>
          <text class="det-list-meta-text">{{viewData.locationText}}</text>
        </view>
        <view class='det-list-meta-item'>
          <text class="det-list-meta-icon">💼</text>
          <text class="det-list-meta-text">{{viewData.experienceText}}</text>
        </view>
        <view class='det-list-meta-item'>
          <text class="det-list-meta-icon">🎓</text>
          <text class="det-list-meta-text">{{viewData.educationText}}</text>
        </view>
      </view>
    </view>

    <view class="det-money"><view>薪资详情</view></view>
    <view class="det-money-list">
      <view class="det-info-row"><text class="det-info-label">工种：</text><text class="det-info-value">{{viewData.payTypeText}}</text></view>
      <view class="det-info-row"><text class="det-info-label">职业方向：</text><text class="det-info-value">{{viewData.jobDirectionText}}</text></view>
      <view class="det-info-row"><text class="det-info-label">最低学历/经验：</text><text class="det-info-value">{{viewData.educationExperienceText}}</text></view>
      <view class="det-info-row"><text class="det-info-label">已报名：</text><text class="det-info-value">{{viewData.entNumText}}人</text></view>
    </view>

    <view class="det-money"><view>职位详情</view></view>
    <view class="det-money-list det-money-list-text">
      <view class="det-sub-title">【岗位说明】</view>
      <rich-text nodes="{{viewData.jobDescriptionText}}"></rich-text>
      <!-- <view class="det-sub-title">【福利待遇】</view> -->
      <!-- <rich-text nodes=""></rich-text> -->
    </view>

    <view class="det-section-divider"></view>
    <view class="det-company-card">
      <image wx:if="{{company.logo}}" class="det-company-logo" src="{{company.logo}}" mode="aspectFill"></image>
      <view wx:else class="det-company-logo det-company-logo--placeholder">企</view>
      <view class="det-company-main">
        <view class="det-company-name">{{company.name}}</view>
        <view class="det-company-meta">{{company.industry}} · {{company.financeStage}} · {{company.companyPeople}}</view>
      </view>
    </view>

    <view class="message-board-host" wx:if="{{detailMessageEnabled}}">
      <message-board target-type="job" target-id="{{jobId}}" detail-message-enabled="{{detailMessageEnabled}}"></message-board>
    </view>
  </view>

  <view class="det-nav">
    <view class="det-nav-left">
      <image wx:if="{{viewData.recruiterAvatar}}" class="det-nav-avatar" src="{{viewData.recruiterAvatar}}" mode="aspectFill"></image>
      <view wx:else class="det-nav-avatar det-nav-avatar--placeholder">招</view>
      <view class="det-nav-recruiter">
        <view class="det-nav-name">{{viewData.recruiterName}}</view>
        <view class="det-nav-role">{{viewData.recruiterRole}}</view>
      </view>
    </view>
    <view class="det-nav-right">
      <view class="det-nav-btn" bindtap="bindViewServicePhone">电话咨询</view>
      <button class="det-nav-btn det-nav-contact" bindtap="bindViewXWZX">微信咨询</button>
      <view wx:if="{{hasJoined}}" class="det-nav-btn" bindtap="cancelJoin">取消报名</view>
      <view wx:else class="det-nav-btn" bindtap="bindViewPutinfor">马上报名</view>
    </view>
  </view>
</view>
