<view class="mycollect-page">
  <view class="zhiyan-tabbar">
    <view
      wx:for="{{tabs}}"
      wx:key="type"
      class="zhiyan-tab {{currentTab == index ? 'active' : ''}}"
      data-index="{{index}}"
      bindtap="onTabTap"
    >{{item.text}}</view>
  </view>

  <view class="collect-list">
    <block wx:for="{{items}}" wx:key="collectRecordId">
      <view wx:if="{{currentType == '1'}}" class="job-card job-card--recruit" bindtap="showDetail" data-index="{{index}}">
        <view class="job-card__header">
          <view class="job-card__title-wrap">
            <text class="job-card__title">{{item.cardTitle}}</text>
            <text wx:if="{{item.cardBadge}}" class="job-card__badge job-card__badge--primary">{{item.cardBadge}}</text>
          </view>
          <view class="job-card__salary-wrap">
            <text class="job-card__salary">{{item.cardSalary}}</text>
            <view class="job-card__more" catchtap="openActionSheet" data-index="{{index}}">
              <view class="job-card__more-dot"></view>
              <view class="job-card__more-dot"></view>
              <view class="job-card__more-dot"></view>
            </view>
          </view>
        </view>
        <view class="job-card__company job-card__company--recruit">
          <text>{{item.cardCompany}}</text>
          <text>{{item.cardCompanySize}}</text>
          <text>{{item.cardFinancing}}</text>
        </view>
        <view class="job-card__tags">
          <text class="job-card__tag" wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view class="job-card__footer">
          <view class="job-card__recruiter">
            <image wx:if="{{item.avatar}}" class="job-card__avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view wx:else class="job-card__avatar job-card__avatar--empty"></view>
            <text class="job-card__recruiter-name">{{item.cardRecruiter}}</text>
          </view>
          <text class="job-card__location">{{item.cardLocation}}</text>
        </view>
      </view>

      <view wx:else class="job-card job-card--seeker" bindtap="showDetail" data-index="{{index}}">
        <view class="job-card__header">
          <view class="job-card__title-wrap">
            <text class="job-card__title">{{item.cardTitle}}</text>
            <text wx:if="{{item.cardBadge}}" class="job-card__badge job-card__badge--primary">{{item.cardBadge}}</text>
          </view>
          <view class="job-card__salary-wrap">
            <text class="job-card__salary">{{item.cardSalary}}</text>
            <view class="job-card__more" catchtap="openActionSheet" data-index="{{index}}">
              <view class="job-card__more-dot"></view>
              <view class="job-card__more-dot"></view>
              <view class="job-card__more-dot"></view>
            </view>
          </view>
        </view>
        <view class="job-card__company">
          <text class="job-card__summary">{{item.cardSummary}}</text>
        </view>
        <view class="job-card__tags">
          <text class="job-card__tag" wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
        <view wx:if="{{item.cardPhotos.length > 0}}" class="job-card__photos">
          <image class="job-card__photo" wx:for="{{item.cardPhotos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" />
        </view>
        <view class="job-card__footer">
          <view class="job-card__recruiter">
            <image wx:if="{{item.avatar}}" class="job-card__avatar" src="{{item.avatar}}" mode="aspectFill" />
            <view wx:else class="job-card__avatar job-card__avatar--empty"></view>
            <text class="job-card__recruiter-name">{{item.cardSeeker}}</text>
          </view>
          <text class="job-card__location">{{item.cardLocation}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{isEmpty}}" class="empty-state">
      <view class="empty-state__text">暂无收藏信息</view>
      <button class="empty-state__button" bindtap="onRetryLoad">重新刷新</button>
    </view>
    <view wx:if="{{!isEmpty}}" class="loading">{{loadingTip}}</view>
  </view>

  <view wx:if="{{actionSheetVisible}}" class="action-sheet-mask" catchtap="closeActionSheet" catchtouchmove="noop">
    <view class="action-sheet" catchtap="noop">
      <view class="action-sheet__close" catchtap="closeActionSheet">
        <view class="action-sheet__close-icon"></view>
      </view>
      <view class="action-sheet__option" catchtap="onEditAction">编辑</view>
      <view class="action-sheet__option action-sheet__option--danger" catchtap="onDeleteAction">删除</view>
    </view>
  </view>
</view>
