page{
  background: #f5f5f5;
}

.mycollect-page{
  min-height: 100vh;
  background: #f5f5f5;
}

.zhiyan-tabbar{
  height: 80rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #ededf2;
  box-sizing: border-box;
}

.zhiyan-tab{
  position: relative;
  height: 80rpx;
  line-height: 80rpx;
  margin-right: 56rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 700;
}

.zhiyan-tab.active::after{
  content: "";
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 36rpx;
  height: 6rpx;
  margin-left: -18rpx;
  border-radius: 3rpx;
  background: #fc3;
}

.collect-list{
  padding: 16rpx 16rpx 32rpx;
  box-sizing: border-box;
}

.job-card{
  position: relative;
  margin-bottom: 16rpx;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 18rpx;
  background: #fff;
  box-sizing: border-box;
}

.job-card--recruit{
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx 26rpx;
  border-radius: 14rpx;
}

.job-card__header{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.job-card__title-wrap{
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}

.job-card__title{
  max-width: 100%;
  color: #111;
  font-size: 42rpx;
  line-height: 56rpx;
  font-weight: 700;
}

.job-card--recruit .job-card__title{
  font-size: 36rpx;
  line-height: 48rpx;
}

.job-card__salary-wrap{
  flex: none;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.job-card__salary{
  flex: none;
  color: #13aaa3;
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 700;
  white-space: nowrap;
}

.job-card--recruit .job-card__salary{
  font-size: 34rpx;
  line-height: 48rpx;
}

.job-card__more{
  width: 44rpx;
  min-height: 56rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
}

.job-card--recruit .job-card__more{
  min-height: 48rpx;
}

.job-card__more-dot{
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #9b9b9b;
}

.job-card__badge{
  height: 32rpx;
  line-height: 30rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 2rpx solid #9b9b9b;
  border-radius: 8rpx;
  color: #777;
  font-size: 22rpx;
  box-sizing: border-box;
}

.job-card__badge--primary{
  border-color: #b8794e;
  color: #b8794e;
}

.job-card__company{
  margin-top: 10rpx;
  color: #666;
  font-size: 30rpx;
  line-height: 44rpx;
}

.job-card__company--recruit{
  display: flex;
  flex-wrap: wrap;
  gap: 0 28rpx;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 40rpx;
}

.job-card__company--recruit text{
  margin-right: 28rpx;
}

.job-card__summary{
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card__tags{
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.job-card--recruit .job-card__tags{
  gap: 14rpx;
  margin-top: 20rpx;
}

.job-card__tag{
  max-width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f6f6f6;
  color: #666;
  font-size: 26rpx;
}

.job-card--recruit .job-card__tag{
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f4f4f4;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}

.job-card__photos{
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.job-card__photo{
  flex: 1;
  height: 160rpx;
  border-radius: 20rpx;
  background: #eee;
}

.job-card__footer{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.job-card--recruit .job-card__footer{
  margin-top: 26rpx;
}

.job-card__recruiter{
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.job-card__avatar{
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e9e9e9;
}

.job-card__avatar--empty{
  position: relative;
}

.job-card__avatar--empty::after{
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #bdbdbd;
}

.job-card__recruiter-name{
  margin-left: 14rpx;
  color: #333;
  font-size: 27rpx;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card__location{
  flex: none;
  max-width: 300rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card--recruit .job-card__location{
  max-width: 260rpx;
}

.empty-state{
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 30rpx;
}

.empty-state__text{
  margin-bottom: 24rpx;
}

.empty-state__button{
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  border-radius: 6rpx;
  background: #fc3;
  color: #000;
  font-size: 28rpx;
}

.empty-state__button::after{
  border: none;
}

.loading{
  height: 72rpx;
  line-height: 72rpx;
  color: #9a9da5;
  text-align: center;
  font-size: 26rpx;
}

.action-sheet-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.action-sheet{
  position: relative;
  width: 100%;
  padding: 72rpx 0 24rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #f5f5f5;
  box-sizing: border-box;
}

.action-sheet__close{
  position: absolute;
  right: 24rpx;
  top: 18rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-sheet__title{
  position: absolute;
  top: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  height: 36rpx;
  line-height: 36rpx;
  color: #20232a;
  font-size: 28rpx;
  font-weight: 600;
  white-space: nowrap;
}

.action-sheet__close-icon{
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.action-sheet__close-icon::before,
.action-sheet__close-icon::after{
  content: "";
  position: absolute;
  left: 14rpx;
  top: 0;
  width: 4rpx;
  height: 30rpx;
  border-radius: 2rpx;
  background: #333;
}

.action-sheet__close-icon::before{
  transform: rotate(45deg);
}

.action-sheet__close-icon::after{
  transform: rotate(-45deg);
}

.action-sheet__option{
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  margin-bottom: 2rpx;
  background: #fff;
  color: #111;
  text-align: center;
  font-size: 32rpx;
  font-weight: 500;
}

.action-sheet__option--danger{
  color: #e64340;
}
