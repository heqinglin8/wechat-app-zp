<!--pages/myjobseeks/myjobseeks.wxml-->
<view class="username">我的求职：{{username}}</view>
<view class="content">
  <scroll-view bindscrolltolower="scrolltolower" scroll-y="true" class="scoll-h">
    <checkbox-group bindchange="onSelectChange">
      <block wx:for="{{infor}}" wx:key="objectId">
        <view class="job-card" bindtap="showDetail" data-index="{{index}}">
          <view class="job-card__header">
            <view class="job-card__title-wrap">
              <text class="job-card__title">{{item.cardTitle}}</text>
              <text wx:if="{{item.cardBadge}}" class="job-card__badge job-card__badge--primary">{{item.cardBadge}}</text>
            </view>
            <text class="job-card__salary">{{item.cardSalary}}</text>
          </view>
          <view class="job-card__company">
            <text class="job-card__summary">{{item.cardSummary}}</text>
          </view>
          <view class="job-card__tags">
            <text class="job-card__tag" wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
          </view>
          <view wx:if="{{item.cardPhotos.length > 0}}" class="job-card__photos">
            <image class="job-card__photo" wx:for="{{item.cardPhotos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" />
          </view>
          <view class="job-card__footer">
            <view class="job-card__recruiter">
              <image wx:if="{{item.avatar}}" class="job-card__avatar" src="{{item.avatar}}" mode="aspectFill" />
              <view wx:else class="job-card__avatar job-card__avatar--empty"></view>
              <text class="job-card__recruiter-name">{{item.cardSeeker}}</text>
            </view>
            <text class="job-card__location">{{item.cardLocation}}</text>
          </view>
          <view class="job-card-check" catchtap="noop">
            <checkbox value="{{item.objectId}}"></checkbox>
          </view>
        </view>
      </block>
    </checkbox-group>
    <view wx:if="{{isEmpty}}" class="empty-state">暂未被推荐人</view>
    <view wx:if="{{!isEmpty}}" class="loading">{{loadingTip}}</view>
  </scroll-view>
</view>
<view wx:if="{{selectedCount > 0}}" class="delete-bar" bindtap="deleteinfor">删除</view>
