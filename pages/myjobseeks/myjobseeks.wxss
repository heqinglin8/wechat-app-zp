/* pages/myjobseeks/myjobseeks.wxss */
/* pages/myjoin/myjoin.wxss */

@import "../../wxSearchView/wxSearchView.wxss";

.username{
  height:240rpx;
  line-height: 240rpx;
  text-align: center;
  color: #888;
}

.content{
  height: 100%;
  width: 100%;
  margin-bottom: 10rpx;
}

.job-card{
  margin-bottom: 16rpx;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 18rpx;
  background: #fff;
  box-sizing: border-box;
}
.job-card__header{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.job-card__title-wrap{
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}
.job-card__title{
  max-width: 100%;
  color: #111;
  font-size: 42rpx;
  line-height: 56rpx;
  font-weight: 700;
}
.job-card__salary{
  flex: none;
  color: #13aaa3;
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 700;
  white-space: nowrap;
}
.job-card__badge{
  height: 32rpx;
  line-height: 30rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 2rpx solid #9b9b9b;
  border-radius: 8rpx;
  color: #777;
  font-size: 22rpx;
  box-sizing: border-box;
}
.job-card__badge--primary{
  border-color: #b8794e;
  color: #b8794e;
}
.job-card__company{
  margin-top: 10rpx;
  color: #666;
  font-size: 30rpx;
  line-height: 44rpx;
}
.job-card__summary{
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.job-card__tags{
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.job-card__tag{
  max-width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f6f6f6;
  color: #666;
  font-size: 26rpx;
}
.job-card__photos{
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}
.job-card__photo{
  flex: 1;
  height: 160rpx;
  border-radius: 20rpx;
  background: #eee;
}
.job-card__footer{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}
.job-card__recruiter{
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}
.job-card__avatar{
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e9e9e9;
}
.job-card__avatar--empty{
  position: relative;
}
.job-card__avatar--empty::after{
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #bdbdbd;
}
.job-card__recruiter-name{
  margin-left: 14rpx;
  color: #333;
  font-size: 27rpx;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.job-card__location{
  flex: none;
  max-width: 300rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scoll-h{
  height: 100%;
  margin: 0;
  background: #f5f5f5;
  box-sizing: border-box;
  padding: 16rpx 16rpx 24rpx;
}

/*最后一行*/
.loading{
  width: 100%;
  height: 30px;
  text-align: center;
  line-height: 30px;
  color: #888;
  font-size: 15px;
  border-top: 1px #F7F7F7 solid;
  border-bottom: 1px #F7F7F7 solid;
}
