/* pages/myjoin/myjoin.wxss */
.myjoin-page{
  min-height: 100vh;
  padding: 16rpx 16rpx 24rpx;
  padding-bottom: 120rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.job-card-row{
  position: relative;
  margin-bottom: 18rpx;
}
.job-card-main{
  width: 100%;
}
.job-card{
  position: relative;
  padding: 28rpx 26rpx 26rpx;
  border-radius: 14rpx;
  background: #fff;
  box-sizing: border-box;
}
.job-card-check{
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 3;
}

.job-card__header{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.job-card__title-wrap{
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}
.job-card__title{
  max-width: 100%;
  color: #111;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 700;
}
.job-card__salary{
  flex: none;
  color: #13aaa3;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  white-space: nowrap;
}
.job-card__badge{
  height: 32rpx;
  line-height: 30rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 2rpx solid #9b9b9b;
  border-radius: 8rpx;
  color: #777;
  font-size: 22rpx;
  box-sizing: border-box;
}
.job-card__badge--primary{
  border-color: #b8794e;
  color: #b8794e;
}
.job-card__company{
  display: flex;
  flex-wrap: wrap;
  gap: 0 28rpx;
  margin-top: 18rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 40rpx;
}
.job-card__company text{
  margin-right: 28rpx;
}
.job-card__tags{
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}
.job-card__tag{
  max-width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f4f4f4;
  color: #666;
  font-size: 26rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}
.job-card__footer{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
}
.job-card__recruiter{
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}
.job-card__avatar{
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e9e9e9;
}
.job-card__avatar--empty{
  position: relative;
}
.job-card__avatar--empty::after{
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #bdbdbd;
}
.job-card__recruiter-name{
  margin-left: 14rpx;
  color: #333;
  font-size: 27rpx;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.job-card__location{
  flex: none;
  max-width: 260rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: right;
}

.empty-state{
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 30rpx;
}
.empty-state__text{
  margin-bottom: 24rpx;
}
.empty-state__button{
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  border-radius: 6rpx;
  background: #fc3;
  color: #000;
  font-size: 28rpx;
}
.empty-state__button::after{
  border: none;
}

.delete-bar{
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  height: 42px;
  line-height: 42px;
  text-align: center;
  color: #fff;
  font-size: 16px;
  background: #ff3b30;
  z-index: 10;
}
.job-card__salary-wrap{display:flex;align-items:center;gap:16rpx}.job-card__more{width:40rpx;height:48rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4rpx}.job-card__more-dot{width:6rpx;height:6rpx;border-radius:50%;background:#8b8f98}.action-sheet-mask{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;background:rgba(0,0,0,.45)}.action-sheet{position:relative;width:100%;padding:72rpx 0 24rpx;background:#f5f5f5;border-radius:24rpx 24rpx 0 0}.action-sheet__title{position:absolute;top:24rpx;left:50%;transform:translateX(-50%);height:36rpx;line-height:36rpx;white-space:nowrap;font-size:28rpx;font-weight:600}.action-sheet__close{position:absolute;right:24rpx;top:20rpx;font-size:40rpx}.action-sheet__option{padding:28rpx;text-align:center}.action-sheet__option--danger{color:#e5484d}
