<!--pages/myrecruit/myrecruit.wxml-->
<view class="myrecruit-page">
  <view>
    <block wx:for="{{jobInfo}}" wx:key="joinRecordId">
      <view class="job-card-row">
        <view class="job-card-main" bindtap="showDetail" data-index="{{index}}">
          <view class="job-card">
            <view class="job-card__header">
              <view class="job-card__title-wrap">
                <text class="job-card__title">{{item.cardTitle}}</text>
                <text wx:if="{{item.cardBadge}}" class="job-card__badge job-card__badge--primary">{{item.cardBadge}}</text>
              </view>
              <view class="job-card__salary-wrap"><text class="job-card__salary">{{item.cardSalary}}</text><view class="job-card__more" catchtap="openActionSheet" data-index="{{index}}"><view class="job-card__more-dot"></view><view class="job-card__more-dot"></view><view class="job-card__more-dot"></view></view></view>
            </view>
            <view class="job-card__company">
              <text>{{item.cardCompany}}</text>
              <text>{{item.cardCompanySize}}</text>
              <text>{{item.cardFinancing}}</text>
            </view>
            <view class="job-card__tags">
              <text class="job-card__tag" wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
            </view>
            <view class="job-card__footer">
              <view class="job-card__recruiter">
                <image wx:if="{{item.avatar}}" class="job-card__avatar" src="{{item.avatar}}" mode="aspectFill" />
                <view wx:else class="job-card__avatar job-card__avatar--empty"></view>
                <text class="job-card__recruiter-name">{{item.cardRecruiter}}</text>
              </view>
              <text class="job-card__location">{{item.cardLocation}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>
  <view wx:if="{{isEmpty}}" class="empty-state">
    <view class="empty-state__text">暂无招聘信息</view>
    <button class="empty-state__button" bindtap="onRetryLoad">重新刷新</button>
  </view>
</view>
<view wx:if="{{actionSheetVisible}}" class="action-sheet-mask" catchtap="closeActionSheet"><view class="action-sheet" catchtap="noop"><view class="action-sheet__title">更多功能</view><view class="action-sheet__close" catchtap="closeActionSheet">×</view><view class="action-sheet__option" catchtap="onEditAction">编辑</view><view class="action-sheet__option action-sheet__option--danger" catchtap="onDeleteAction">删除</view></view></view>
