/* pages/personal/personal.wxss */
.personal{
  margin: 0;
  padding: 0;
}
.personal-top{
  width:100%;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.personal-user-card{
  width: 92%;
  height: 220rpx;
  /* padding: 0 20rpx; */
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  overflow: hidden;
}
.personal-user-card-button{
  margin: 0;
  border: none;
  line-height: normal;
}
.personal-user-card-button::after{
  border: none;
}
.personal-user-card-left{
  width: 130rpx;
  height: 130rpx;
  flex-shrink: 0;
}
.personal-user-avatar{
  width: 130rpx;
  height: 130rpx;
  border-radius: 65rpx;
  overflow: hidden;
}
.personal-user-card-center{
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
  overflow: hidden;
}
.personal-user-name{
  color: #111;
  font-size: 40rpx;
  font-weight: 500;
  width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.personal-user-no{
  margin-top: 16rpx;
  color: #444;
  font-size: 38rpx;
  width: 100%;
  text-align: left;
  padding-left: 10rpx;
  box-sizing: border-box;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.personal-user-card-right{
  width: 56rpx;
  height: 80rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.personal-user-arrow{
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid #c7c7c7;
  border-right: 4rpx solid #c7c7c7;
  transform: rotate(45deg);
}
.personal-middle{
  width: 100%;
  height: 545rpx;
  border-top: 1px #e5e5e5 solid;
  border-bottom: 1px #e5e5e5 solid;
}
.per-mid-list1,.per-mid-list2,.per-mid-list3{
  border-bottom: 1px #e5e5e5 solid;
  width: 90%;
  float: right;
  height: 90rpx;
}
.per-mid-list4,.per-mid-list5,.per-mid-list6{
  width: 90%;
  float: right;
  height: 90rpx;
}
.per-mid-list4,.per-mid-list5{
  border-bottom: 1px #e5e5e5 solid;
}
.per-mid-contact-button{
  display: block;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  line-height: normal;
  background: transparent;
  text-align: left;
  box-sizing: border-box;
}
.per-mid-contact-button::after{
  border: none;
}

.per-mid-list-left{
  width:40%;
  height:100%;
  float: left;
}
.per-mid-list-left image{
  width: 30%;
  height: 100%;
  float: left;
}
.per-mid-list-left-text{
  color: #000;
  font-size: 13px;
  line-height: 90rpx;
  width: 60%;
  height: 100%;
  float: right;
}

.per-mid-list-right{
  width:40%;
  height:100%;
  float: right;
}
.per-mid-list-right image{
  width: 30%;
  height: 100%;
  float: right;
}

.personal-logout{
  width: 88%;
  height: 78rpx;
  line-height: 78rpx;
  margin: 48rpx auto 0;
  border: 1px solid #e54d42;
  border-radius: 10rpx;
  color: #e54d42;
  font-size: 30rpx;
  text-align: center;
}

.role-dialog-mask{
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.45);
}

.role-dialog{
  width: 620rpx;
  padding: 40rpx 32rpx 32rpx;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.role-dialog-title{
  color: #111;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.role-options{
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.role-option{
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border: 1px solid #d8d8d8;
  border-radius: 8rpx;
  color: #333;
  font-size: 30rpx;
  text-align: center;
  background: #fff;
  box-sizing: border-box;
}

.role-option-active{
  border-color: #fc3;
  color: #8a5a00;
  background: #fff8df;
}

.role-field{
  margin-top: 28rpx;
}

.role-input{
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 1px solid #d8d8d8;
  border-radius: 8rpx;
  color: #111;
  font-size: 30rpx;
  box-sizing: border-box;
}

.role-confirm{
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin-top: 32rpx;
  border-radius: 8rpx;
  color: #111;
  font-size: 32rpx;
  background: #fc3;
}
