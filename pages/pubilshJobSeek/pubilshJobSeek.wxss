/* pages/pubilshJobSeek/pubilshJobSeek.wxss */
.award-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.award {
  margin: 0;
  padding: 0 0 120rpx;
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
}

.award-image {
  width: 100%;
  height: 360rpx;
  position: relative;
  overflow: hidden;
}

.award-image image {
  width: 100%;
  height: 100%;
}

.award-intro {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 36%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 2;
  pointer-events: none;
}

.award-list {
  width: 100%;
  margin-top: 36rpx;
  margin-bottom: 24rpx;
}

.award-city-row {
  display: flex;
  align-items: center;
  width: 80%;
  margin: 10px auto 0;
  min-height: 100rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.award-city-label {
  width: 20%;
  flex-shrink: 0;
  line-height: 80rpx;
  text-align: left;
  color: #333;
  font-size: 15px;
}

.award-city-value {
  flex: none;
  width: 78%;
  margin-left: auto;
  min-width: 0;
  min-height: 80rpx;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  border: 1px #fc3 solid;
  border-radius: 10rpx;
  box-shadow: 0px 0px 3px rgba(55, 55, 55, 0.5);
  color: #111;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.award-city-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.award-city-tip {
  margin-top: 4rpx;
  color: #888;
  font-size: 22rpx;
}

.award-list-name {
  margin-top: 10px;
  font-size: 15px;
  line-height: 100rpx;
  min-height: 100rpx;
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
}

.award-picker-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.award-picker-row .name-text {
  float: none;
  flex-shrink: 0;
  width: 20%;
}

.award-salary-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.award-salary-row .name-text {
  float: none;
  flex-shrink: 0;
  width: 20%;
}

.award-salary-inputs {
  flex: 1;
  display: flex;
  margin-left: 12rpx;
  min-width: 0;
}

.award-salary-input {
  float: none;
  width: auto;
  flex: 1;
  min-width: 0;
}

.award-salary-input + .award-salary-input {
  margin-left: 10px;
}

.award-salary-unit {
  margin-left: 12rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1;
  white-space: nowrap;
}

.award-picker {
  flex: 1;
  box-shadow: 0 0 3px rgba(55, 55, 55, 0.5);
  border-radius: 10rpx;
  border: 1px #fc3 solid;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-left: 12rpx;
}

.picker-display {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-placeholder {
  color: #888;
}

.job-intent-input {
  display: flex;
  align-items: center;
  color: #111;
}

.job-intent-input text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-text {
  line-height: 80rpx;
  text-align: left;
  float: left;
  width: 20%;
}

.name-input {
  box-shadow: 0px 0px 3px rgba(55, 55, 55, 0.5);
  border-radius: 10rpx;
  border: 1px #fc3 solid;
  float: right;
  height: 80rpx;
  line-height: 80rpx;
  width: 78%;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.award-list-textarea {
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  margin-top: 16rpx;
}

.award-list-textarea-extra {
  margin-bottom: 8rpx;
}

.label-block {
  font-size: 15px;
  margin-bottom: 12rpx;
  color: #333;
}

.award-photo-section {
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  margin-top: 16rpx;
}

.award-photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.award-photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 8rpx;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 0 3px rgba(55, 55, 55, 0.35);
  border: 1px solid #fc3;
}

.award-photo-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.award-photo-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.award-photo-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  background: rgba(0, 0, 0, 0.55);
  padding: 8rpx 0;
}

.award-photo-act {
  font-size: 22rpx;
  color: #fc3;
  padding: 0 12rpx;
}

.award-photo-act.danger {
  color: #ffb4b4;
}

.award-photo-add {
  width: 200rpx;
  height: 200rpx;
  margin: 8rpx;
  border-radius: 10rpx;
  border: 1px dashed #ccc;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
}

.award-photo-add-plus {
  font-size: 56rpx;
  line-height: 1;
}

.award-photo-add-text {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.award-textarea {
  box-shadow: 0px 0px 3px rgba(55, 55, 55, 0.5);
  border-radius: 10rpx;
  border: 1px #fc3 solid;
  width: 100%;
  height: 160rpx;
  min-height: 80rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 14px;
  line-height: 1.5;
}

.text-one,
.text-tow {
  color: #fff;
  font-size: 14px;
  line-height: 1.5;
  text-shadow: 0 1px 4px rgba(0,0,0,0.3);
}

.text-one {
  margin-top: 12rpx;
}

.text-tow {
  margin-top: 10rpx;
  margin-bottom: 8rpx;
}

.award-btn {
  height: 43px;
  line-height: 43px;
  text-align: center;
  margin-top: 36rpx;
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  border-radius: 5px;
  background: #fc3;
}

.job-type-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.job-type-panel {
  width: 100%;
  height: 980rpx;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  border-radius: 22rpx 22rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.job-type-title {
  flex: none;
  height: 92rpx;
  line-height: 92rpx;
  color: #222;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.job-type-body {
  flex: 1;
  min-height: 0;
  display: flex;
  background: #fff;
}

.job-type-categories {
  flex: none;
  width: 196rpx;
  height: 100%;
  background: #fff;
  border-right: 1rpx solid #f2f2f2;
  box-sizing: border-box;
}

.job-type-category {
  position: relative;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #111;
  font-size: 29rpx;
  line-height: 38rpx;
  box-sizing: border-box;
  white-space: normal;
}

.job-type-category--active {
  color: #13aaa3;
  font-weight: 600;
}

.job-type-category--active::before {
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 6rpx;
  height: 48rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #13aaa3;
}

.job-type-options {
  flex: 1;
  height: 100%;
  padding: 24rpx 24rpx 30rpx;
  box-sizing: border-box;
}

.job-type-group-title {
  margin: 26rpx 0 18rpx;
  color: #111;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.job-type-option-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 28rpx;
}

.job-type-option {
  width: 230rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #222;
  font-size: 28rpx;
  line-height: 38rpx;
  box-sizing: border-box;
}

.job-type-option--category-all {
  margin-bottom: 20rpx;
}

.job-type-option--active {
  color: #13aaa3;
  background: #eef6ff;
}

.job-type-actions {
  flex: none;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 34rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-sizing: border-box;
}

.job-type-action {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 30rpx;
  text-align: center;
}

.job-type-action::after {
  border: none;
}

.job-type-action--cancel {
  color: #777;
  background: #f4f4f4;
}

.job-type-action--reset {
  color: #fff;
  background: #ff3517;
}

.job-type-action--confirm {
  color: #fff;
  background: #13aaa3;
}
