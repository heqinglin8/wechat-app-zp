page{
  min-height: 100%;
  background: #f5f6fb;
}

.publish-page{
  min-height: 100vh;
  background: #fff;
  color: #202124;
  font-size: 28rpx;
}

.publish-nav{
  height: 112rpx;
  box-sizing: content-box;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  background: #fff;
  border-bottom: 1rpx solid #f0f1f5;
}

.publish-close{
  position: absolute;
  left: 28rpx;
  bottom: 22rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 58rpx;
  line-height: 1;
  color: #101215;
}

.publish-nav-title{
  font-size: 36rpx;
  font-weight: 600;
  color: #111;
}

.publish-submit{
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  min-width: 112rpx;
  height: 60rpx;
  padding: 0 26rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.publish-submit.disabled{
  color: #b8bbca;
  background: #eff0f7;
}

.publish-submit.enabled{
  color: #fff;
  background: #2d7df6;
}

.publish-scroll{
  box-sizing: border-box;
  padding: 0 28rpx 188rpx;
}

.publish-author{
  min-height: 126rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f2f3f6;
}

.publish-avatar{
  width: 74rpx;
  height: 74rpx;
  border-radius: 50%;
  background: #eef1f6;
  flex: 0 0 auto;
}

.publish-author-main{
  min-width: 0;
  margin-left: 20rpx;
}

.publish-author-name{
  max-width: 610rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #202124;
  font-size: 29rpx;
  line-height: 40rpx;
}

.publish-author-hint{
  margin-top: 4rpx;
  color: #a9adb8;
  font-size: 25rpx;
  line-height: 34rpx;
}

.publish-title-row{
  min-height: 98rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f1f5;
}

.publish-title-input{
  min-width: 0;
  flex: 1;
  height: 88rpx;
  color: #202124;
  font-size: 31rpx;
  line-height: 88rpx;
}

.publish-title-count{
  margin-left: 18rpx;
  color: #aeb2be;
  font-size: 28rpx;
}

.publish-placeholder{
  color: #b3b7c2;
}

.publish-content{
  width: 100%;
  min-height: 360rpx;
  box-sizing: border-box;
  padding: 30rpx 0 10rpx;
  color: #202124;
  font-size: 32rpx;
  line-height: 46rpx;
}

.publish-photo-grid{
  display: grid;
  grid-template-columns: repeat(3, 184rpx);
  gap: 18rpx;
  padding: 28rpx 0 120rpx;
}

.publish-photo-cell,
.publish-photo-add{
  width: 184rpx;
  height: 184rpx;
  border-radius: 8rpx;
  position: relative;
  overflow: hidden;
  background: #f7f8fb;
}

.publish-photo{
  width: 100%;
  height: 100%;
}

.publish-photo-mask{
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  background: rgba(0, 0, 0, 0.48);
}

.publish-photo-remove{
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  line-height: 1;
  background: rgba(0, 0, 0, 0.58);
}

.publish-photo-add{
  border: 2rpx dashed #cfd3dc;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c1c5d1;
}

.publish-photo-add-icon{
  font-size: 74rpx;
  line-height: 1;
}

.publish-photo-add-plus{
  position: absolute;
  right: 48rpx;
  top: 50rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  background: #c7cbe0;
}

.publish-tools{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 98rpx;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 140rpx;
  background: #fff;
  border-top: 1rpx solid #eef0f4;
  z-index: 20;
}

.publish-tool{
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111318;
  font-size: 48rpx;
  line-height: 1;
}

.publish-emoji-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 98rpx;
  padding: 24rpx 28rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  background: #fff;
  border-top: 1rpx solid #eef0f4;
  box-shadow: 0 -8rpx 18rpx rgba(38, 42, 52, 0.04);
  z-index: 19;
}

.publish-emoji{
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  border-radius: 8rpx;
  background: #f6f7fb;
}
