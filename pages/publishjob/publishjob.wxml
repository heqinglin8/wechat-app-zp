<!--pages/award/award.wxml-->
<scroll-view class="award-scroll" scroll-y>
  <view class="award">
    <view class="award-list">
      <view class="award-city-row">
        <view class="award-city-label">城市</view>
        <view class="award-city-value">
          <text class="award-city-text">{{currentCityText}}</text>
          <text class="award-city-tip">只能发布本城市的信息</text>
        </view>
      </view>

      <view class="award-list-name">
        <view class="name-text">标题</view>
        <input class="name-input" type="text" placeholder="标题" value="{{title}}" bindinput="onTitleInput" />
      </view>

      <view class="award-list-name award-picker-row">
        <view class="name-text">结算方式</view>
        <picker class="award-picker" mode="selector" range="{{payTypeOptions}}" value="{{payTypeIndex}}" bindchange="onPayTypeChange">
          <view class="picker-display">{{payTypeOptions[payTypeIndex]}}</view>
        </picker>
      </view>

      <view class="award-list-name award-picker-row">
        <view class="name-text">职位方向</view>
        <view class="award-picker company-select-input" bindtap="openJobTypePopup">
          <view class="picker-display {{selectedJobTypeLabel ? '' : 'picker-placeholder'}}">{{selectedJobTypeLabel || '请选择职能'}}</view>
          <text class="company-select-arrow">›</text>
        </view>
      </view>

      <view class="award-list-name award-picker-row">
        <view class="name-text">公司</view>
        <view class="award-picker company-select-input" bindtap="openCompanySelector">
          <view class="picker-display {{selectedCompanyName ? '' : 'picker-placeholder'}}">{{selectedCompanyName || '请选择公司'}}</view>
          <text class="company-select-arrow">›</text>
        </view>
      </view>

      <view class="award-list-name award-picker-row">
        <view class="name-text">最低学历</view>
        <picker class="award-picker" mode="selector" range="{{educationOptions}}" value="{{educationIndex}}" bindchange="onEducationChange">
          <view class="picker-display">{{educationOptions[educationIndex]}}</view>
        </picker>
      </view>

      <view class="award-list-name">
        <view class="name-text">电话</view>
        <input class="name-input" type="number" maxlength="20" placeholder="手机号" value="{{contact}}" bindinput="onContactInput" />
      </view>

      <view class="award-list-name">
        <view class="name-text">微信</view>
        <input class="name-input" type="text" maxlength="40" placeholder="微信号" value="{{wxid}}" bindinput="onWxidInput" />
      </view>

      <view class="award-list-name">
        <view class="name-text">经验</view>
        <input class="name-input" type="text" placeholder="3-5年/不限经验" value="{{experience}}" bindinput="onExperienceInput" />
      </view>

      <view class="award-list-name award-salary-row">
        <view class="name-text">薪资</view>
        <view class="award-salary-inputs">
          <input class="name-input award-salary-input" type="number" placeholder="最低" value="{{detPayMin}}" bindinput="onDetPayMinInput" />
          <input class="name-input award-salary-input" type="number" placeholder="最高" value="{{detPayMax}}" bindinput="onDetPayMaxInput" />
        </view>
        <view class="award-salary-unit">{{payType == '1' ? '/天' : '/月'}}</view>
      </view>

      <view class="award-list-textarea">
        <view class="label-block">摘要</view>
        <textarea class="short-textarea summary-textarea" placeholder="请输入职位摘要，字数在40以内..." value="{{summary}}" bindinput="onSummaryInput" maxlength="40" />
      </view>

      <view class="award-list-textarea award-list-textarea-extra">
        <view class="label-block">职位描述</view>
        <textarea class="award-textarea" placeholder="职位描述，多个要求可用 | 分隔" value="{{jobDescription}}" bindinput="onJobDescriptionInput" maxlength="800" />
      </view>

      <view class="award-photo-section">
        <view class="label-block">上传图片（选填，最多 3 张）</view>
        <view class="award-photo-grid">
          <block wx:for="{{recommendPhotos}}" wx:key="index">
            <view class="award-photo-cell">
              <image wx:if="{{item.uploading}}" class="award-photo-thumb" src="{{item.tempPath}}" mode="aspectFill" />
              <image wx:elif="{{item.url}}" class="award-photo-thumb" src="{{item.url}}" mode="aspectFill" />
              <view wx:if="{{item.uploading}}" class="award-photo-mask">上传中</view>
              <view class="award-photo-actions">
                <text class="award-photo-act" catchtap="onReplacePhoto" data-index="{{index}}">替换</text>
                <text class="award-photo-act danger" catchtap="onRemovePhoto" data-index="{{index}}">删除</text>
              </view>
            </view>
          </block>
          <view wx:if="{{recommendPhotos.length < 3}}" class="award-photo-add" bindtap="onAddPhotos">
            <text class="award-photo-add-plus">+</text>
            <text class="award-photo-add-text">添加</text>
          </view>
        </view>
      </view>
      
    </view>

    <view class="award-btn" bindtap="put_infor">确定</view>
  </view>

  <view wx:if="{{companySelectorVisible}}" class="company-selector-mask" catchtap="closeCompanySelector">
    <view class="company-selector-panel" catchtap="noop">
      <view class="company-selector-header">
        <text class="company-selector-close" bindtap="closeCompanySelector">×</text>
        <text class="company-selector-title">选择公司</text>
        <text class="company-selector-done" bindtap="confirmCompanySelection">确认</text>
      </view>
      <scroll-view class="company-selector-list" scroll-y>
        <block wx:if="{{companies.length}}">
          <view wx:for="{{companies}}" wx:key="objectId" class="company-selector-item {{pendingCompanyIndex == index ? 'active' : ''}}" data-index="{{index}}" bindtap="onCompanyCandidateTap">
            <view class="company-selector-name">{{item.name}}</view>
            <view class="company-selector-meta">{{item.companyPeople}}人 · {{item.financeStage}} · {{item.cityName}}{{item.districtName}}</view>
          </view>
        </block>
        <view wx:else class="company-selector-empty">暂无公司信息</view>
      </scroll-view>
      <view class="company-selector-add" bindtap="goPublishCompany">找不到公司？去录入</view>
    </view>
  </view>

  <view wx:if="{{jobTypePopupVisible}}" class="job-type-mask" bindtap="closeJobTypePopup" catchtouchmove="noop">
    <view class="job-type-panel" catchtap="noop">
      <view class="job-type-title">请选择职能</view>
      <view class="job-type-body">
        <scroll-view scroll-y="true" class="job-type-categories">
          <view
            wx:for="{{jobTypeCategories}}"
            wx:key="code"
            class="job-type-category {{activeJobTypeCategoryCode == item.code ? 'job-type-category--active' : ''}}"
            data-code="{{item.code}}"
            bindtap="selectJobTypeCategory"
          >{{item.name}}</view>
        </scroll-view>
        <scroll-view scroll-y="true" class="job-type-options">
          <view
            class="job-type-option job-type-option--category-all {{tempJobTypeCode == activeJobTypeCategoryCode ? 'job-type-option--active' : ''}}"
            data-code="{{activeJobTypeCategoryCode}}"
            bindtap="selectJobTypeOption"
          >全部</view>
          <block wx:for="{{activeJobTypeGroups}}" wx:for-item="group" wx:key="code">
            <view class="job-type-group-title">{{group.name}}</view>
            <view class="job-type-option-grid">
              <view
                wx:for="{{group.children}}"
                wx:for-item="option"
                wx:key="code"
                class="job-type-option {{tempJobTypeCode == option.code ? 'job-type-option--active' : ''}}"
                data-code="{{option.code}}"
                bindtap="selectJobTypeOption"
              >{{option.name}}</view>
            </view>
          </block>
        </scroll-view>
      </view>
      <view class="job-type-actions">
        <button class="job-type-action job-type-action--cancel" bindtap="closeJobTypePopup">取消</button>
        <button class="job-type-action job-type-action--reset" bindtap="resetJobTypeFilter">重置</button>
        <button class="job-type-action job-type-action--confirm" bindtap="confirmJobTypeFilter">确定</button>
      </view>
    </view>
  </view>

</scroll-view>
