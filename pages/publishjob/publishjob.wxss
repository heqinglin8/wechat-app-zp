/* pages/award/award.wxss */
.award-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.award {
  margin: 0;
  padding: 0 0 120rpx;
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
}

.award-image {
  width: 100%;
  height: 360rpx;
  position: relative;
  overflow: hidden;
}

.award-image image {
  width: 100%;
  height: 100%;
}

.award-intro {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 36%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 2;
  pointer-events: none;
}

.award-list {
  width: 100%;
  margin-top: 36rpx;
  margin-bottom: 24rpx;
}

.award-city-row {
  display: flex;
  align-items: center;
  width: 80%;
  margin: 10px auto 0;
  min-height: 100rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.award-city-label {
  width: 20%;
  flex-shrink: 0;
  line-height: 80rpx;
  text-align: left;
  color: #333;
  font-size: 15px;
}

.award-city-value {
  flex: none;
  width: 78%;
  margin-left: auto;
  min-width: 0;
  min-height: 80rpx;
  padding: 8rpx 16rpx;
  box-sizing: border-box;
  border: 1px #fc3 solid;
  border-radius: 10rpx;
  box-shadow: 0px 0px 3px rgba(55, 55, 55, 0.5);
  color: #111;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.award-city-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.award-city-tip {
  margin-top: 4rpx;
  color: #888;
  font-size: 22rpx;
}

.award-list-name {
  margin-top: 10px;
  font-size: 15px;
  line-height: 100rpx;
  min-height: 100rpx;
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  overflow: hidden;
}

.award-picker-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.award-picker-row .name-text {
  float: none;
  flex-shrink: 0;
  width: 20%;
}

.award-salary-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.award-salary-row .name-text {
  float: none;
  flex-shrink: 0;
  width: 20%;
}

.award-salary-inputs {
  flex: 1;
  display: flex;
  margin-left: 12rpx;
}

.award-salary-input {
  float: none;
  width: auto;
  flex: 1;
  min-width: 0;
}

.award-salary-input + .award-salary-input {
  margin-left: 10px;
}

.award-picker {
  flex: 1;
  box-shadow: 0 0 3px rgba(55, 55, 55, 0.5);
  border-radius: 10rpx;
  border: 1px #fc3 solid;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  margin-left: 12rpx;
}

.picker-display {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.name-text {
  line-height: 80rpx;
  text-align: left;
  float: left;
  width: 20%;
}

.name-input {
  box-shadow: 0px 0px 3px rgba(55, 55, 55, 0.5);
  border-radius: 10rpx;
  border: 1px #fc3 solid;
  float: right;
  height: 80rpx;
  line-height: 80rpx;
  width: 78%;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.award-list-textarea {
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  margin-top: 16rpx;
}

.award-list-textarea-extra {
  margin-bottom: 8rpx;
}

.label-block {
  font-size: 15px;
  margin-bottom: 12rpx;
  color: #333;
}

.award-photo-section {
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  margin-top: 16rpx;
}

.award-photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.award-photo-cell {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 8rpx;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 0 3px rgba(55, 55, 55, 0.35);
  border: 1px solid #fc3;
}

.award-photo-thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.award-photo-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.award-photo-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  justify-content: space-around;
  background: rgba(0, 0, 0, 0.55);
  padding: 8rpx 0;
}

.award-photo-act {
  font-size: 22rpx;
  color: #fc3;
  padding: 0 12rpx;
}

.award-photo-act.danger {
  color: #ffb4b4;
}

.award-photo-add {
  width: 200rpx;
  height: 200rpx;
  margin: 8rpx;
  border-radius: 10rpx;
  border: 1px dashed #ccc;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
}

.award-photo-add-plus {
  font-size: 56rpx;
  line-height: 1;
}

.award-photo-add-text {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.award-textarea {
  box-shadow: 0px 0px 3px rgba(55, 55, 55, 0.5);
  border-radius: 10rpx;
  border: 1px #fc3 solid;
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 14px;
  line-height: 1.5;
}

.text-one,
.text-tow {
  color: #fff;
  font-size: 14px;
  line-height: 1.5;
  text-shadow: 0 1px 4px rgba(0,0,0,0.3);
}

.text-one {
  margin-top: 12rpx;
}

.text-tow {
  margin-top: 10rpx;
  margin-bottom: 8rpx;
}

.award-btn {
  height: 43px;
  line-height: 43px;
  text-align: center;
  margin-top: 36rpx;
  width: 80%;
  margin-left: auto;
  margin-right: auto;
  border-radius: 5px;
  background: #fc3;
}
