<!--pages/setinfor/setinfor.wxml-->
<view class="profile-page">
  <button class="profile-card profile-card-button" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
    <view class="profile-label">头像</view>
    <image class="profile-avatar" src="{{avatarUrl}}"></image>
  </button>

  <view class="info-list">

    <view class="info-row" bindtap="openUsernameDialog">
      <view class="info-row-label">用户名</view>
      <view class="info-row-right">
        <view class="info-row-value">{{username || '--'}}</view>
        <view class="info-row-arrow"></view>
      </view>
    </view>

    <view class="info-row" bindtap="openNicknameDialog">
      <view class="info-row-label">昵称</view>
      <view class="info-row-right">
        <view class="info-row-value">{{nickname || '--'}}</view>
        <view class="info-row-arrow"></view>
      </view>
    </view>

    <view class="info-row" bindtap="openPhoneDialog">
      <view class="info-row-label">手机号</view>
      <view class="info-row-right">
        <view class="info-row-value">{{mobilePhoneNumber || '--'}}</view>
        <view class="info-row-arrow"></view>
      </view>
    </view>

    <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="info-row">
        <view class="info-row-label">性别</view>
        <view class="info-row-right">
          <view class="info-row-value">{{gender || '请选择'}}</view>
          <view class="info-row-arrow"></view>
        </view>
      </view>
    </picker>

    <picker mode="date" value="{{birthday}}" start="1900-01-01" end="2099-12-31" bindchange="onBirthdayChange">
      <view class="info-row">
        <view class="info-row-label">出生日期</view>
        <view class="info-row-right">
          <view class="info-row-value">{{birthday || '请选择出生日期'}}</view>
          <view class="info-row-arrow"></view>
        </view>
      </view>
    </picker>

    <view class="info-row info-row-last">
      <view class="info-row-label">注册日期</view>
      <view class="info-row-right">
        <view class="info-row-value">{{registerDate || '--'}}</view>
      </view>
    </view>
  </view>

  <view class="save-button" bindtap="bindViewPut">保存</view>

  <view wx:if="{{showInputDialog}}" class="input-dialog-mask" catchtouchmove="noop">
    <view class="input-dialog" catchtap="noop">
      <view class="input-dialog-title">{{dialogTitle}}</view>
      <input
        class="input-dialog-field"
        type="{{dialogInputType}}"
        maxlength="{{dialogMaxLength}}"
        placeholder="{{dialogPlaceholder}}"
        value="{{dialogValue}}"
        bindinput="onDialogInput"
      />
      <view class="input-dialog-actions">
        <view class="input-dialog-btn" bindtap="cancelInputDialog">取消</view>
        <view class="input-dialog-btn input-dialog-btn-confirm" bindtap="confirmInputDialog">确定</view>
      </view>
    </view>
  </view>
</view>
