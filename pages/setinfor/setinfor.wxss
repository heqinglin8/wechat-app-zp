/* pages/setinfor/setinfor.wxss */
.profile-page{
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #f5f5f5;
}

.profile-card{
  width: 100%;
  height: 190rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.profile-avatar{
  width: 116rpx;
  height: 116rpx;
  border-radius: 58rpx;
  flex-shrink: 0;
}

.profile-label{
  color: #111;
  font-size: 38rpx;
}

.info-list{
  margin-top: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  overflow: hidden;
}

.info-row{
  height: 96rpx;
  padding: 0 26rpx;
  border-bottom: 1px solid #efefef;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info-row-last{
  border-bottom: none;
}

.info-row-label{
  color: #111;
  font-size: 32rpx;
}

.info-row-right{
  max-width: 72%;
  display: flex;
  align-items: center;
  min-width: 0;
}

.info-row-value{
  color: #666;
  font-size: 30rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.info-row-arrow{
  width: 16rpx;
  height: 16rpx;
  margin-left: 16rpx;
  border-top: 3rpx solid #c7c7c7;
  border-right: 3rpx solid #c7c7c7;
  transform: rotate(45deg);
  flex-shrink: 0;
}

.save-button{
  height: 86rpx;
  line-height: 86rpx;
  margin-top: 56rpx;
  border-radius: 43rpx;
  color: #111;
  font-size: 32rpx;
  text-align: center;
  background: #fc3;
}

.input-dialog-mask{
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-dialog{
  width: 84%;
  border-radius: 20rpx;
  background: #fff;
  overflow: hidden;
}

.input-dialog-title{
  padding: 40rpx 28rpx 24rpx;
  color: #666;
  font-size: 34rpx;
  text-align: center;
}

.input-dialog-field{
  width: calc(100% - 60rpx);
  height: 80rpx;
  margin: 0 30rpx 24rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  box-sizing: border-box;
  color: #111;
  font-size: 30rpx;
}

.input-dialog-actions{
  height: 92rpx;
  border-top: 1px solid #efefef;
  display: flex;
}

.input-dialog-btn{
  flex: 1;
  line-height: 92rpx;
  color: #666;
  font-size: 34rpx;
  text-align: center;
}

.input-dialog-btn-confirm{
  color: #0b8cff;
  border-left: 1px solid #efefef;
}
