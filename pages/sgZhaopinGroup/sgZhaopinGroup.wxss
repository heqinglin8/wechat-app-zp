page {
  background: #f5f5f5;
}

.group-page {
  min-height: 100vh;
  padding: 56rpx 32rpx;
  box-sizing: border-box;
}

.group-card {
  padding: 44rpx 32rpx 52rpx;
  border-radius: 20rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.06);
}

.group-title {
  color: #111;
  font-size: 42rpx;
  line-height: 58rpx;
  font-weight: 700;
}

.group-qr {
  width: 560rpx;
  max-width: 100%;
  margin-top: 36rpx;
  border-radius: 16rpx;
}

.group-tip {
  margin-top: 28rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 40rpx;
}
