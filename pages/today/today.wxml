<view class="today-page">
    <view class="weui-search-bar">
      <view class="weui-search-bar__form">
          <view class="weui-search-bar__box">
            <icon class="weui-icon-search_in-box" type="search" size="14"></icon>
            <input type="text" class="weui-search-bar__input"  disabled='true' placeholder="搜索工作：如广州、深圳、韶关" bindtap="wxSearchTab"/>
          </view>
      </view>
    </view>
  <view class="today-top">
    <view class="today-entry">
      <button class="today-entry__item today-entry__button" open-type="contact">
        <view class="today-entry__icon today-entry__icon--wechat">
          <image src="../../images/wechat_green.png" mode="aspectFit"></image>
        </view>
        <text class="today-entry__text">加入群聊</text>
      </button>
      <view class="today-entry__item" data-current="3" bindtap="swichNav">
        <view class="today-entry__icon today-entry__icon--hot">
          <text>火</text>
        </view>
        <text class="today-entry__text">热门兼职</text>
      </view>
      <view class="today-entry__item" data-current="2" bindtap="swichNav">
        <view class="today-entry__icon today-entry__icon--money">
          <text>¥</text>
        </view>
        <text class="today-entry__text">高薪机会</text>
      </view>
      <view class="today-entry__item" data-current="0" bindtap="swichNav">
        <view class="today-entry__icon today-entry__icon--match">
          <text>速</text>
        </view>
        <text class="today-entry__text">今日速配</text>
      </view>
    </view>
  </view>

  <view class="page-body">
    <scroll-view scroll-y="true" scroll-x="true" class="tab-h" scroll-left="{{scrollLeft}}">
      <view class="tab-h__inner">
        <view class="tab-group tab-group--left">
          <view class="tab-item {{currentTab==1?'active':''}}" data-current="1" bindtap="swichNav">最新</view>
          <view class="tab-item {{currentTab==0?'active':''}}" data-current="0" bindtap="swichNav">推荐</view>
          <view class="tab-item">附近</view>
        </view>
        <view class="tab-group tab-group--right">
          <view class="tab-item tab-item--filter">薪资<text class="tab-item__arrow"></text></view>
          <view class="tab-item tab-item--filter {{appliedJobTypeCode != '000' ? 'tab-item--filter-active' : ''}}" bindtap="openJobTypePopup">{{jobTypeFilterText}}<text class="tab-item__arrow"></text></view>
          <view class="tab-item tab-item--filter">筛选<text class="tab-item__arrow"></text></view>
        </view>
      </view>
    </scroll-view>
    <swiper class="tab-content" current="{{currentTab}}" duration="300" bindchange="switchTab">
        <swiper-item wx:for="{{[0,1,2,3]}}" wx:key="*this">
            <scroll-view bindscrolltolower="scrolltolower" scroll-y="true"    class="scoll-h" >
                <block wx:for="{{jobInfo}}" wx:key="objectId">
                  <view class="job-card {{isJobSeekerMode ? 'job-card--seeker' : ''}}" bindtap="showDetail" data-index="{{index}}">
                    <view class="job-card__header">
                      <view class="job-card__title-wrap">
                        <text class="job-card__title">{{item.cardTitle}}</text>
                        <text wx:if="{{item.cardBadge}}" class="job-card__badge job-card__badge--primary">{{item.cardBadge}}</text>
                      </view>
                      <text class="job-card__salary">{{item.cardSalary}}</text>
                    </view>
                    <view wx:if="{{isJobSeekerMode}}" class="job-card__company">
                      <text class="job-card__summary">{{item.cardSummary}}</text>
                    </view>
                    <view wx:else class="job-card__company">
                      <text>{{item.cardCompany}}</text>
                      <text>{{item.cardCompanySize}}</text>
                      <text>{{item.cardFinancing}}</text>
                    </view>
                    <view class="job-card__tags">
                      <text class="job-card__tag" wx:for="{{item.cardTags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
                    </view>
                    <view wx:if="{{isJobSeekerMode && item.cardPhotos && item.cardPhotos.length > 0}}" class="job-card__photos">
                      <image class="job-card__photo" wx:for="{{item.cardPhotos}}" wx:for-item="photo" wx:key="*this" src="{{photo}}" mode="aspectFill" />
                    </view>
                    <view class="job-card__footer">
                      <view class="job-card__recruiter">
                        <image wx:if="{{item.avatar}}" class="job-card__avatar" src="{{item.avatar}}" mode="aspectFill" />
                        <view wx:else class="job-card__avatar job-card__avatar--empty"></view>
                        <text class="job-card__recruiter-name">{{isJobSeekerMode ? item.cardSeeker : item.cardRecruiter}}</text>
                      </view>
                      <text class="job-card__location">{{item.cardLocation}}</text>
                    </view>
                  </view>                  
                </block>
                <view wx:if="{{isEmpty}}" class="empty-state">
                  <view class="empty-state__text">暂无信息</view>
                  <button class="empty-state__button" bindtap="onRetryLoad">重新刷新</button>
                </view>
                <view wx:if="{{!isEmpty}}" class="loading">{{loadingTip}}</view>
            </scroll-view>
            
        </swiper-item>
    </swiper>
  </view>

  <view wx:if="{{jobTypePopupVisible}}" class="job-type-mask" bindtap="closeJobTypePopup" catchtouchmove="noop">
    <view class="job-type-panel" catchtap="noop">
      <view class="job-type-title">请选择职能</view>
      <view class="job-type-body">
        <scroll-view scroll-y="true" class="job-type-categories">
          <view
            wx:for="{{jobTypeCategories}}"
            wx:key="code"
            class="job-type-category {{activeJobTypeCategoryCode == item.code ? 'job-type-category--active' : ''}}"
            data-code="{{item.code}}"
            bindtap="selectJobTypeCategory"
          >{{item.name}}</view>
        </scroll-view>
        <scroll-view scroll-y="true" class="job-type-options">
          <view
            class="job-type-option job-type-option--category-all {{tempJobTypeCode == activeJobTypeCategoryCode ? 'job-type-option--active' : ''}}"
            data-code="{{activeJobTypeCategoryCode}}"
            bindtap="selectJobTypeOption"
          >全部</view>
          <block wx:for="{{activeJobTypeGroups}}" wx:for-item="group" wx:key="code">
            <view class="job-type-group-title">{{group.name}}</view>
            <view class="job-type-option-grid">
              <view
                wx:for="{{group.children}}"
                wx:for-item="option"
                wx:key="code"
                class="job-type-option {{tempJobTypeCode == option.code ? 'job-type-option--active' : ''}}"
                data-code="{{option.code}}"
                bindtap="selectJobTypeOption"
              >{{option.name}}</view>
            </view>
          </block>
        </scroll-view>
      </view>
      <view class="job-type-actions">
        <button class="job-type-action job-type-action--cancel" bindtap="closeJobTypePopup">取消</button>
        <button class="job-type-action job-type-action--reset" bindtap="resetJobTypeFilter">重置</button>
        <button class="job-type-action job-type-action--confirm" bindtap="confirmJobTypeFilter">确定</button>
      </view>
    </view>
  </view>
</view>

<!-- 右下角悬浮按钮入口 -->
<fab />
