@import "../wxSearchView/wxSearchView.wxss";

page{
  background: #f5f5f5;
}

.today-page{
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f5f5;
}
.job-card{
  margin-bottom: 18rpx;
  padding: 28rpx 26rpx 26rpx;
  border-radius: 14rpx;
  background: #fff;
  box-sizing: border-box;
}
.job-card--seeker{
  margin-bottom: 16rpx;
  padding: 24rpx 22rpx 22rpx;
  border-radius: 18rpx;
}
.job-card__header{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}
.job-card__title-wrap{
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}
.job-card__title{
  max-width: 100%;
  color: #111;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 700;
}
.job-card--seeker .job-card__title{
  font-size: 42rpx;
  line-height: 56rpx;
}
.job-card__salary{
  flex: none;
  color: #13aaa3;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  white-space: nowrap;
}
.job-card--seeker .job-card__salary{
  font-size: 46rpx;
  line-height: 56rpx;
}
.job-card__badge{
  height: 32rpx;
  line-height: 30rpx;
  margin-left: 10rpx;
  padding: 0 8rpx;
  border: 2rpx solid #9b9b9b;
  border-radius: 8rpx;
  color: #777;
  font-size: 22rpx;
  box-sizing: border-box;
}
.job-card__badge--primary{
  border-color: #b8794e;
  color: #b8794e;
}
.job-card__company{
  display: flex;
  flex-wrap: wrap;
  gap: 0 28rpx;
  margin-top: 18rpx;
  color: #666;
  font-size: 28rpx;
  line-height: 40rpx;
}
.job-card__company text{
  margin-right: 28rpx;
}
.job-card--seeker .job-card__company{
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 44rpx;
}
.job-card__summary{
  display: block;
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.job-card__tags{
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}
.job-card__tag{
  max-width: 100%;
  height: 44rpx;
  line-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #f4f4f4;
  color: #666;
  font-size: 26rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}
.job-card--seeker .job-card__tags{
  gap: 12rpx;
  margin-top: 16rpx;
}
.job-card--seeker .job-card__tag{
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f6f6f6;
  margin-right: 0;
  margin-bottom: 0;
}
.job-card__photos{
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}
.job-card__photo{
  flex: 1;
  height: 160rpx;
  border-radius: 20rpx;
  background: #eee;
}
.job-card__footer{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 26rpx;
}
.job-card--seeker .job-card__footer{
  margin-top: 16rpx;
}
.job-card__recruiter{
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}
.job-card__avatar{
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e9e9e9;
}
.job-card__avatar--empty{
  position: relative;
}
.job-card__avatar--empty::after{
  content: "";
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #bdbdbd;
}
.job-card__recruiter-name{
  margin-left: 14rpx;
  color: #333;
  font-size: 27rpx;
  line-height: 38rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.job-card__location{
  flex: none;
  max-width: 260rpx;
  color: #777;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: right;
}
.job-card--seeker .job-card__location{
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/*滚动tab*/
.page-body{
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}
.tab-h{
  flex: none;
  height: 90rpx;
  width: 100%;
  box-sizing: border-box;
  margin-left: auto;
  margin-right: auto;
  margin-top: 0;
  line-height: 82rpx;
  background: #fff;
  font-size: 30rpx;
  white-space: nowrap;
  top: 0;
  left: 0;
  z-index: 99;
  border-bottom: 1rpx solid #f1f1f1;
}
.tab-h__inner{
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}
.tab-group{
  display: flex;
  align-items: center;
  height: 100rpx;
}
.tab-group--left{
  justify-content: flex-start;
}
.tab-group--right{
  justify-content: flex-end;
}
.tab-item{
  height: 90rpx;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  padding: 0 18rpx;
  color: #999;
  font-size: 30rpx;
  font-weight: 400;
  text-align: center;
  box-sizing: border-box;
}
.tab-item.active{
  color: #111;
  position: relative;
  background: transparent;
  font-size: 34rpx;
  font-weight: 800;
}
.tab-item__arrow{
  width: 0;
  height: 0;
  margin-left: 12rpx;
  margin-top: 18rpx;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-bottom: 12rpx solid #9a9a9a;
}
.tab-item--filter-active{
  color: #13aaa3;
}
.tab-item--filter-active .tab-item__arrow{
  border-bottom-color: #13aaa3;
}
.tab-content{
  flex: 1;
  min-height: 0;
  background: #f5f5f5;
}
.scoll-h{
  height: 100%;
  margin: 0;
  background: #f5f5f5;
  box-sizing: border-box;
  padding: 16rpx 16rpx 24rpx;
}

/*最后一行*/
.loading{
  width: 100%;
  height: 30px;
  text-align: center;
  line-height: 30px;
  color: #888;
  font-size: 15px;
  border-top: 1px #F7F7F7 solid;
  border-bottom: 1px #F7F7F7 solid;
}
.empty-state{
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 30rpx;
}
.empty-state__text{
  margin-bottom: 24rpx;
}
.empty-state__button{
  width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  border-radius: 6rpx;
  background: #fc3;
  color: #000;
  font-size: 28rpx;
}
.empty-state__button::after{
  border: none;
}

.job-type-mask{
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.4);
}

.job-type-panel{
  width: 100%;
  height: 980rpx;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  border-radius: 22rpx 22rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.job-type-title{
  flex: none;
  height: 92rpx;
  line-height: 92rpx;
  color: #222;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  border-bottom: 1rpx solid #eee;
}

.job-type-body{
  flex: 1;
  min-height: 0;
  display: flex;
  background: #fff;
}

.job-type-categories{
  flex: none;
  width: 196rpx;
  height: 100%;
  background: #fff;
  border-right: 1rpx solid #f2f2f2;
  box-sizing: border-box;
}

.job-type-category{
  position: relative;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  color: #111;
  font-size: 29rpx;
  line-height: 38rpx;
  box-sizing: border-box;
  white-space: normal;
}

.job-type-category--active{
  color: #13aaa3;
  font-weight: 600;
}

.job-type-category--active::before{
  content: "";
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 6rpx;
  height: 48rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #13aaa3;
}

.job-type-options{
  flex: 1;
  height: 100%;
  padding: 24rpx 24rpx 30rpx;
  box-sizing: border-box;
}

.job-type-group-title{
  margin: 26rpx 0 18rpx;
  color: #111;
  font-size: 32rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.job-type-option-grid{
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 28rpx;
}

.job-type-option{
  width: 230rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #222;
  font-size: 28rpx;
  line-height: 38rpx;
  box-sizing: border-box;
}

.job-type-option--category-all{
  margin-bottom: 20rpx;
}

.job-type-option--active{
  color: #13aaa3;
  background: #eef6ff;
}

.job-type-actions{
  flex: none;
  display: flex;
  gap: 24rpx;
  padding: 24rpx 34rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  box-sizing: border-box;
}

.job-type-action{
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  font-size: 30rpx;
  text-align: center;
}

.job-type-action::after{
  border: none;
}

.job-type-action--cancel{
  color: #777;
  background: #f4f4f4;
}

.job-type-action--reset{
  color: #fff;
  background: #ff3517;
}

.job-type-action--confirm{
  color: #fff;
  background: #13aaa3;
}

.filter-mask{
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.45);
}

.filter-panel{
  position: relative;
  width: 100%;
  height: 930rpx;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
  overflow: hidden;
}

.filter-title{
  flex: none;
  height: 94rpx;
  line-height: 94rpx;
  color: #111;
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.filter-close{
  position: absolute;
  right: 28rpx;
  top: 18rpx;
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  color: #222;
  font-size: 60rpx;
  font-weight: 300;
  text-align: center;
}

.filter-body{
  flex: 1;
  min-height: 0;
  padding: 0 30rpx 20rpx;
  box-sizing: border-box;
}

.filter-section{
  margin-bottom: 28rpx;
}

.filter-section-title{
  margin: 10rpx 0 22rpx;
  color: #111;
  font-size: 31rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.filter-option-grid{
  display: flex;
  flex-wrap: wrap;
  gap: 28rpx 28rpx;
}

.filter-option{
  width: 210rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 4rpx;
  background: #f7f7f7;
  color: #333;
  font-size: 29rpx;
  text-align: center;
  box-sizing: border-box;
}

.filter-option--active{
  color: #13aaa3;
  font-weight: 700;
  background: #f0f8ff;
}

.filter-actions{
  flex: none;
  display: flex;
  gap: 30rpx;
  padding: 24rpx 30rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}

.filter-action{
  height: 86rpx;
  line-height: 86rpx;
  margin: 0;
  padding: 0;
  border-radius: 10rpx;
  font-size: 32rpx;
  text-align: center;
}

.filter-action::after{
  border: none;
}

.filter-action--clear{
  flex: none;
  width: 132rpx;
  color: #555;
  background: #f7f7f7;
}

.filter-action--confirm{
  flex: 1;
  color: #fff;
  background: #13aaa3;
}
