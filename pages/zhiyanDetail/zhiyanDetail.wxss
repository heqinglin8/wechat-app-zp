page{
  background: #f4f4f8;
}

.zhiyan-detail{
  min-height: 100vh;
  background: #f4f4f8;
  color: #222;
}

.detail-loading,
.detail-empty{
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #888;
  font-size: 30rpx;
}

.detail-empty button{
  width: 180rpx;
  height: 64rpx;
  margin-top: 24rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #fc3;
  color: #222;
  line-height: 64rpx;
  font-size: 28rpx;
}

.detail-empty button::after{
  border: none;
}

.detail-card{
  padding: 26rpx 30rpx 0;
  background: #fff;
}

.detail-author{
  display: flex;
  align-items: center;
}

.detail-avatar{
  flex: none;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eee;
}

.detail-author-main{
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.detail-name-row{
  display: flex;
  align-items: center;
  min-width: 0;
}

.detail-name{
  max-width: 420rpx;
  color: #222733;
  font-size: 31rpx;
  line-height: 42rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-badge{
  flex: none;
  margin-left: 12rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  background: #efe7ff;
  color: #7b5bd6;
  font-size: 20rpx;
  line-height: 28rpx;
}

.detail-meta{
  margin-top: 4rpx;
  color: #9a9da5;
  font-size: 23rpx;
  line-height: 32rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.detail-title{
  margin-top: 30rpx;
  color: #191f2b;
  font-size: 39rpx;
  line-height: 56rpx;
  font-weight: 700;
  word-break: break-word;
}

.detail-content{
  margin-top: 26rpx;
  color: #202735;
  font-size: 32rpx;
  line-height: 56rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.detail-photos{
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 26rpx;
}

.detail-photo{
  width: 100%;
  height: 208rpx;
  border-radius: 8rpx;
  background: #eee;
}

.detail-publish-place{
  margin-top: 24rpx;
  color: #a3a7b0;
  font-size: 24rpx;
  line-height: 36rpx;
}

.detail-actions{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  border-top: 1rpx solid #f1f1f3;
}

.detail-action{
  flex: 1;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: #b4b6bd;
  font-size: 26rpx;
  line-height: 82rpx;
}

.detail-action::after{
  border: none;
}

.detail-action.liked{
  color: #fc3;
}

.detail-action-icon{
  font-size: 30rpx;
  line-height: 1;
  color: inherit;
}

.detail-like-icon{
  color: #b4b6bd;
}

.detail-action.liked .detail-like-icon{
  color: #fc3;
}

.detail-comments{
  margin-top: 14rpx;
  padding: 4rpx 0 32rpx;
  background: #fff;
}

.detail-comments .message-board{
  width: auto;
  margin: 0 30rpx 40rpx;
}
